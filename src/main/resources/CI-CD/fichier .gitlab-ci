voici le fichier correcte pour le cree le pipeline


stages:
  - build
  - test

build:
  stage: build
  image: maven:3.9.6-eclipse-temurin-17
  script:
    - mvn clean package -DskipTests -B

test:
  stage: test
  image: maven:3.9.6-eclipse-temurin-17
  services:
    - name: postgres:15
      alias: postgres
  variables:
    POSTGRES_DB: tenderflow_db
    POSTGRES_USER: postgres
    POSTGRES_PASSWORD: 1111
    SPRING_DATASOURCE_URL: jdbc:postgresql://postgres:5432/tenderflow_db
    SPRING_DATASOURCE_USERNAME: postgres
    SPRING_DATASOURCE_PASSWORD: 1111
    SPRING_JPA_HIBERNATE_DDL_AUTO: create-drop
  before_script:
    - echo "En attente que PostgreSQL soit prêt..."
    - sleep 10
  script:
    - mvn test -B